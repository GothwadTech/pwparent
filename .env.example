# =============================================================================
#  PW Parent's App — environment template
# =============================================================================
#  Copy this file, fill in the values, and keep the copy OUTSIDE git:
#
#      cp .env.example .env.local          # local development
#
#  RULES (Vite + Cloudflare Pages):
#   * Only variables prefixed with VITE_ reach the browser. Vite inlines them
#     at BUILD TIME, so they must exist when `vite build` runs — not at runtime.
#   * NEVER put a secret here (Gemini key, service-account JSON, DB password).
#     Secrets belong in Cloudflare Pages Functions:
#         npx wrangler pages secret put GEMINI_API_KEY --project-name=pwparent
#   * Values starting with MY_ are treated as "not set" by src/lib/config.ts,
#     so you can commit/deploy this template safely — the app falls back to
#     mock data instead of breaking.
#   * Same keys in the Cloudflare Pages dashboard:
#         Pages project -> Settings -> Environment variables
#     (add them for BOTH Production and Preview, then re-run the deployment)
# =============================================================================

# ---------- App ----------
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000
VITE_APP_VERSION=1.0.0

# ---------- Firebase web config (public values — safe in the browser) ----------
# Firebase console -> Project settings -> General -> Your apps -> SDK setup
# You can keep these exact names (no VITE_ prefix); src/lib/config.ts reads
# FIREBASE_* as a fallback so the console snippet can be pasted as-is.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="G-MYMEASUREMENT"

# Optional — only if you use the Realtime Database instead of/in addition to Firestore
# VITE_FIREBASE_DATABASE_URL="https://MY_PROJECT_ID-default-rtdb.firebaseio.com"

# ---------- Backend switch ----------
# mock     = demo data, no network (default; app works with zero setup)
# firebase = Firebase Auth (phone OTP) + Firestore
# 'firebase' is ignored unless all 6 required vars above are filled, so a
# half-configured env can never white-screen the app.
VITE_BACKEND_MODE=mock

# ---------- Optional: Firebase phone auth on web ----------
# Needed if you enable reCAPTCHA Enterprise / App Check.
# VITE_RECAPTCHA_SITE_KEY="MY_RECAPTCHA_SITE_KEY"

# ---------- Legacy (AI Studio) ----------
# GEMINI_API_KEY is a SERVER secret. Do not add a VITE_ prefix to it.
# It is read by functions/api/ai.ts from Cloudflare Pages secrets / .dev.vars.
# GEMINI_API_KEY=""
