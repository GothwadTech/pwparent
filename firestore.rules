rules_version = '2';

/**
 * PW Parent App — Firestore security rules.
 *
 * ── THREAT MODEL ───────────────────────────────────────────────────────────
 * This is a pure client-side SPA. Everything here is enforced server-side by
 * Firestore, which is the ONLY real security boundary the app has — the JS
 * bundle is public and any client-side check is advisory.
 *
 * Collections:
 *   parents/{uid}                  profile (phone is a FIELD, not a credential)
 *   parents/{uid}/children/{id}    academic record
 *   parents/{uid}/purchases/{id}   orders
 *   announcements/{id}             shared feed, admin-written
 *   admins/{uid}                   role marker — the admin allow-list
 *   adminConfig/singleton          closes registration after the first admin
 *   credentials/{phone}            PBKDF2 digest of a phone's login code
 *
 * ── THE ADMIN SLOT ─────────────────────────────────────────────────────────
 * Whoever registers first becomes the one and only admin, permanently.
 * `admins/{uid}` can be CREATED only while `adminConfig/singleton` does not
 * exist, and `registerAdmin()` writes both documents in a single batch. A batch
 * is atomic and `exists()` sees pre-batch state, so the window closes the
 * instant the first admin is created. Both documents are then immutable from
 * the app — revoking an admin is a Firebase console operation.
 *
 * ── LOGIN CODES ────────────────────────────────────────────────────────────
 * `get` is allowed for anyone because the browser must fetch the digest to
 * verify a typed code (there is no server to do it for us). `list` is
 * admin-only, so the collection cannot be enumerated to discover which numbers
 * are registered. Writes are admin-only. The plaintext code is never stored —
 * see src/lib/credentials.ts.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** True when the caller's uid is in the admin allow-list. */
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * The family subtree this login number is bound to, or null.
     *
     * An admin creates a child under `parents/{P}` and issues the number's
     * login code from that child's screen, stamping
     * `credentials/{phone}.parentUid = P`. The parent's session uid is whatever
     * their device/identity produced, so "my data" is the credential's binding,
     * not `request.auth.uid` — otherwise a parent who logs in from a second
     * phone (or after a cleared profile) reads an empty subtree and sees an
     * empty dashboard even though every record exists.
     *
     * The caller's phone is read from their own profile shell, which the app
     * writes at sign-in; four document gets, all behind the app's read cache.
     */
    function boundParentUid() {
      if (!signedIn()) return null;
      if (!exists(/databases/$(database)/documents/parents/$(request.auth.uid))) return null;
      let phone = get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.mobileNumber;
      if (!(phone is string)) return null;
      if (!exists(/databases/$(database)/documents/credentials/$(phone))) return null;
      return get(/databases/$(database)/documents/credentials/$(phone)).data.parentUid;
    }

    /** True when `uid` is the family this login code was issued for. */
    function isBoundParent(uid) {
      return boundParentUid() == uid;
    }

    /** True only while no admin has ever been created. */
    function adminSlotIsOpen() {
      return !exists(/databases/$(database)/documents/adminConfig/singleton);
    }

    /**
     * True when the caller has been allotted into this batch.
     *
     * Keyed on the member document's id BEING the parent uid, so this is a
     * single `exists()` — no query, no scan.
     */
    function isBatchMember(batchId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/batches/$(batchId)/members/$(request.auth.uid));
    }

    /**
     * True when `studentId` is one of THIS caller's children in this batch.
     *
     * `&&` short-circuits in rules, so the `get()` only runs once membership is
     * already proven — it can never throw on a missing document.
     *
     * This is what stops one parent reading another family's attendance or
     * marks inside the same batch. Being in the batch is not the same as
     * owning every record in it.
     */
    function isParentOfStudent(batchId, studentId) {
      return isBatchMember(batchId) &&
        get(/databases/$(database)/documents/batches/$(batchId)/members/$(request.auth.uid))
          .data.studentIds.hasAny([studentId]);
    }

    /** Canonical Indian mobile: exactly 10 digits, no separators. */
    function validPhone(phone) {
      return phone is string && phone.matches('^[0-9]{10}$');
    }

    function validCredential() {
      return request.resource.data.keys().hasAll(['v', 'salt', 'iterations', 'hash', 'createdAt']) &&
        request.resource.data.v is int &&
        request.resource.data.salt is string &&
        request.resource.data.salt.size() >= 16 &&
        request.resource.data.iterations is int &&
        request.resource.data.iterations >= 100000 &&
        request.resource.data.hash is string &&
        request.resource.data.hash.size() >= 32;
    }

    function validAdminDoc() {
      return request.resource.data.keys().hasAll(['username', 'role', 'createdAt']) &&
        request.resource.data.username is string &&
        request.resource.data.username.matches('^[a-z0-9._-]{3,30}$') &&
        request.resource.data.role == 'owner';
    }

    // ── admin slot ─────────────────────────────────────────────────────────
    // World-readable ON PURPOSE: the login screen must know whether
    // registration is still open before anyone is authenticated. It therefore
    // stores no username and nothing else sensitive.

    match /adminConfig/singleton {
      allow get: if true;
      // Creatable exactly once, by whoever claims the admin slot first.
      allow create: if signedIn() && adminSlotIsOpen();
      // Never updatable or deletable from the app. Resetting the admin is a
      // console operation, not a client one.
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isBoundParent(uid);
      // The first admin creates their own marker while the slot is open. After
      // that this is permanently closed — no second admin can ever be added.
      allow create: if isOwner(uid) && adminSlotIsOpen() && validAdminDoc();
      allow update, delete: if false;
      // An admin's own record is not enumerable by strangers.
      allow list: if isAdmin();
    }

    // ── login codes (phone + admin-set 6-digit code) ───────────────────────

    match /credentials/{phone} {
      // Anyone may GET one document: the browser has to fetch the digest to
      // check a typed code. Knowing a phone number is not a secret, and the
      // digest is salted + peppered with 210k PBKDF2 rounds.
      allow get: if validPhone(phone);
      // Never listable by non-admins — that would expose which numbers are
      // registered.
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validPhone(phone) && validCredential();
      allow delete: if isAdmin();
    }

    // ── parent data ────────────────────────────────────────────────────────
    // Owners have full access to their own subtree. Admins get access to ANY
    // subtree because the Admin Panel exists to manage other people's records.

    match /parents/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isBoundParent(uid);
      allow create, update: if isOwner(uid) || isAdmin() || isBoundParent(uid);
      // Deletion is a console operation — the app signs out instead.
      allow delete: if false;
      allow list: if isAdmin();

      match /children/{childId} {
        allow read: if isOwner(uid) || isAdmin() || isBoundParent(uid);
        allow create, update: if isOwner(uid) || isAdmin() || isBoundParent(uid);
        allow delete: if isOwner(uid) || isAdmin() || isBoundParent(uid);
      }

      match /purchases/{itemId} {
        allow read: if isOwner(uid) || isAdmin() || isBoundParent(uid);
        allow create, update: if isOwner(uid) || isAdmin() || isBoundParent(uid);
        allow delete: if isOwner(uid) || isAdmin() || isBoundParent(uid);
      }

      // Any subcollection added later is DENIED until a rule is written for it
      // — Firestore does not cascade, so nothing here widens silently.
    }

    // ── batches ────────────────────────────────────────────────────────────
    // Admin-owned. A parent may READ the batches they have been allotted into,
    // but inside a batch they may only read records belonging to THEIR OWN
    // children — never another family's attendance or marks.
    //
    // COST NOTE: every `exists()` / `get()` in a rule is itself a billable
    // document read. A parent reading a batch therefore costs 2 reads (the
    // batch + the membership check), and reading a result costs 3. Both are
    // behind `cachedRead` in the app, so it happens once per minute per key,
    // not once per render. Admins skip the membership check entirely.

    match /batches/{batchId} {
      allow get: if isAdmin() || isBatchMember(batchId);
      // Parents discover their batches by `get()`ing the ids recorded on their
      // own children's profiles — they are never allowed to list the collection.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /members/{parentUid} {
        // A parent sees only their own membership document.
        allow get: if isAdmin() || isOwner(parentUid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // One document per student holding every month. The id IS the student id,
      // which is what makes `isParentOfStudent` expressible without parsing a
      // composite key.
      // DPP record for one student. Same isolation as attendance: a parent
      // reads only their own child's; the administrator reads and writes all.
      match /dpp/{studentId} {
        allow get: if isAdmin() || isParentOfStudent(batchId, studentId);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /attendance/{studentId} {
        allow get: if isAdmin() || isParentOfStudent(batchId, studentId);
        // The whole-batch month grid is an admin view. A parent listing it
        // would receive other families' records, so list is admin-only.
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /tests/{testId} {
        // The test itself (title, date, syllabus) is batch information: every
        // member may read it. Marks are not — see results below.
        allow read: if isAdmin() || isBatchMember(batchId);
        allow create, update, delete: if isAdmin();

        match /results/{studentId} {
          allow get: if isAdmin() || isParentOfStudent(batchId, studentId);
          // A parent reads their own child's result by targeted `get()`, never
          // by listing the class.
          allow list: if isAdmin();
          allow create, update, delete: if isAdmin();
        }
      }
    }

    // ── announcements ──────────────────────────────────────────────────────
    // Shared feed: every signed-in visitor reads it, only an admin writes it.

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── default deny ───────────────────────────────────────────────────────
    // There is deliberately no `match /{document=**}` catch-all here: Firestore
    // already denies every path that no rule allows, and a root-level recursive
    // wildcard would overlap all of the matches above. Anything not listed in
    // this file is unreadable and unwritable.
  }
}
