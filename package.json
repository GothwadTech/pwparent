{
  "name": "pw-parent-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PW Parent's App - Vite + React 19 SPA, deployed on Cloudflare Pages with a Firebase-ready backend layer.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/check-node.mjs && vite build",
    "preview": "vite preview --host=0.0.0.0 --port=4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:build": "node scripts/check-build-output.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:build",
    "clean": "rm -rf dist node_modules/.vite .wrangler",
    "pages:build": "npm run build && node scripts/check-build-output.mjs",
    "pages:dev": "npm run pages:build && npx --yes wrangler@4 pages dev dist --ip=0.0.0.0 --port=8788",
    "pages:deploy": "npm run pages:build && npx --yes wrangler@4 pages deploy --project-name=pwparent --branch=main"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^12.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
