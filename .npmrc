# Keeps `npm ci` / `npm install` predictable on Cloudflare Pages + GitHub Actions.
#
# - No audit/fund noise in build logs.
# - Optional native deps (platform esbuild binaries, workerd, sharp, canvas)
#   are installed by default; never add `omit=optional` here or the build breaks.
# - legacy-peer-deps=true fixes npm arborist "Cannot read properties of null (reading 'edgesOut')"
#   when Cloudflare Pages runs `npm install --progress=false`.
fund=false
audit=false
loglevel=warn
legacy-peer-deps=true
