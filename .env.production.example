# =============================================================================
#  Production overrides — TEMPLATE ONLY (copy, fill, keep the copy out of git)
# =============================================================================
#  On Cloudflare Pages you normally do NOT need this file: set the same keys in
#  Pages -> Settings -> Environment variables (Production). Cloudflare writes
#  them into the build environment before `npm run build`, and Vite inlines them.
#
#  Use this file only if you want production values checked into a private repo
#  or for `vite build --mode production` on your laptop:
#
#      cp .env.production.example .env.production
#
#  Vite load order (later wins): .env  ->  .env.production  ->  .env.production.local
#  Cloudflare Pages env vars override all of them during the Pages build.
# =============================================================================

VITE_APP_ENV=production
VITE_APP_URL=https://pwparent.pages.dev
VITE_APP_VERSION=1.0.0

VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="pwparent.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="pwparent"
VITE_FIREBASE_STORAGE_BUCKET="pwparent.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Flip to firebase only after the values above are real.
VITE_BACKEND_MODE=firebase
